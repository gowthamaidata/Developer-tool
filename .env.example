# Copy this file to ".env" and fill in the values you need. All are optional.

# Your live website address, without a trailing slash. Used for canonical URLs,
# sitemap.xml and robots.txt. Example: https://devtoolshub.dev
VITE_SITE_URL=

# Email address shown on the Contact page. If set, the contact form opens the
# visitor's email app with the message pre-filled.
VITE_CONTACT_EMAIL=

# Optional form endpoint (e.g. Formspree, Basin, your own API) that accepts a JSON POST
# with { name, email, subject, message }. Takes priority over VITE_CONTACT_EMAIL.
VITE_CONTACT_ENDPOINT=

# Analytics measurement ID (e.g. a Google Analytics "G-XXXX" ID). Leave empty for no analytics.
# See src/lib/analytics.ts. Update the Privacy Policy before enabling.
VITE_ANALYTICS_ID=

# Set to "true" to render the reserved ad slots (see src/components/AdSlot.tsx).
VITE_ADS_ENABLED=false
